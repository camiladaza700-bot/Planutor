<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>PLANUTOR - Inicio</title>
  <link rel="stylesheet" href="/css/tema.css">
</head>

<body class="pagina-panel">
  <%- include('partials/menu') %>

    <header class="barra">

        <div class="logo">
            PLANUTOR
        </div>

        <div class="usuario">
            <div class="foto">👤</div>
            <span>Estudiante</span>
        </div>

    </header>

    <main class="contenido">

        <section class="bienvenida">

            <h1>¡Hola, estudiante! </h1>

            <p>
                Organiza tus actividades y consulta tu progreso académico.
            </p>

        </section>

        <section class="tarjetas">

            <a href="/clases/estudiante/<%= currentUser.id %>" class="tarjeta">
                <div class="icono"></div>
                <h2>Mis materias</h2>
                <p>Consulta y únete a tus clases.</p>
            </a>

            <a href="/panel/<%= currentUser.id %>#tareas" class="tarjeta">
                <div class="icono"></div>
                <h2>Tareas</h2>
                <p>Revisa tus actividades.</p>
            </a>

            <a href="/calendario?personaje=estudiante&amp;usuarioId=<%= currentUser.id %>" class="tarjeta">
                <div class="icono"></div>
                <h2>Calendario</h2>
                <p>Organiza tus fechas.</p>
            </a>

            <article class="tarjeta">
                <div class="icono"></div>
                <h2>Mi progreso</h2>
                <p>Esta función estará disponible próximamente.</p>
            </article>

            <article class="tarjeta">
                <div class="icono"></div>
                <h2>Mi historial</h2>
                <p>Esta función estará disponible próximamente.</p>
            </article>

            <article class="tarjeta">
                <div class="icono"></div>
                <h2>Mi perfil</h2>
                <p>Esta función estará disponible próximamente.</p>
            </article>

        </section>

        <section class="actividades">

            <h2> Próximas actividades</h2>

            <div class="actividad">
                <span>Matemáticas — Taller</span>
                <span class="fecha">Próximamente</span>
            </div>

            <div class="actividad">
                <span>Inglés — Actividad</span>
                <span class="fecha">Próximamente</span>
            </div>

        </section>

    </main>

</body>
</html>
