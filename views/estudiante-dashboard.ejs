<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Muro semanal - PLANUTOR</title>
  <link rel="stylesheet" href="/css/tema.css">
</head>
<body class="pagina-panel">
  <%- include('partials/menu') %>
  <main class="contenedor">
    <section class="hero">
      <h1>Muro semanal de tareas</h1>
      <% if (bienvenida) { %>
        <div class="welcome-banner" role="status">¡Bienvenido/a, <%= currentUser.nombre %>!</div>
      <% } %>
      <p><strong><%= currentUser.nombre %></strong>, aqui ves las tareas publicadas para tu curso en la semana <strong><%= semana.inicio %></strong> a <strong><%= semana.fin %></strong>.</p>
      <p>Tu curso: <strong>Grado <%= currentUser.grado || '-' %> - Grupo <%= currentUser.grupo || '-' %></strong>.</p>
      <% if (mensaje) { %><div class="alerta ok"><%= mensaje %></div><% } %>
      <% if (error) { %><div class="alerta error"><%= error %></div><% } %>
    </section>

    <section class="buscador-ia seccion">
      <div class="ia-encabezado">
        <div>
          <h2>Asistente IA</h2>
          <p>Haz preguntas sobre tus estudios. La conversación se guarda para conservar el contexto.</p>
        </div>
        <div class="ia-acciones">
          <button type="button" onclick="nuevaConversacion()">Nueva conversación</button>
          <span id="limiteIA" aria-live="polite"></span>
        </div>
      </div>
      <div id="conversacionesIA" class="conversaciones-ia"></div>
      <div id="chatIA" class="chat-ia" aria-live="polite"></div>

      <div class="buscador-contenedor">
        <input
          type="text"
          id="preguntaIA"
          placeholder="¿Qué quieres aprender hoy?"
          autocomplete="off"
          onkeydown="if (event.key === 'Enter') buscarConIA()"
        >
        <button type="button" id="btnIA" onclick="buscarConIA()">Preguntar</button>
      </div>
    </section>

    <!-- INICIO recordatorios -->
    <section class="hero" id="recordatorios-box">
      <h2>Recordatorios</h2>
      <div id="lista-recordatorios">Cargando recordatorios...</div>
    </section>
    <script>
      fetch('/recordatorios?usuarioId=<%= currentUser.id %>')
        .then((r) => r.json())
        .then((data) => {
          const cont = document.getElementById('lista-recordatorios');
          const items = data.recordatorios || [];
          if (items.length === 0) {
            cont.innerHTML = '<p class="vacio">No tienes tareas próximas por ahora.</p>';
            return;
          }
          cont.innerHTML = items.map((t) =>
            `<p> <strong>${t.titulo}</strong> (${t.materia}) vence el ${t.fecha_entrega}</p>`
          ).join('');
        })
        .catch(() => {
          document.getElementById('lista-recordatorios').innerHTML = '<p class="vacio">No fue posible cargar los recordatorios.</p>';
        });
    </script>
    <!-- FIN recordatorios -->

    <section class="muro" id="tareas">
      <h2>Tareas de la semana</h2>
      <p><a href="/tareas/<%= currentUser.id %>">Ver próximas, vencidas e historial de tareas</a></p>
      <% if (tareas.length === 0) { %>
        <p class="vacio">No hay tareas publicadas para tu grado y grupo esta semana.</p>
      <% } else { %>
        <div class="lista">
          <% tareas.forEach((tarea) => { %>
            <article class="tarea">
              <h3><%= tarea.titulo %></h3>
              <div class="meta">
                <span class="chip materia">Grado <%= tarea.grado %> - Grupo <%= tarea.grupo %></span>
                <span class="chip materia"><%= tarea.materia %></span>
                <span class="chip profesor">Profesor: <%= tarea.profesor_nombre %></span>
                <span class="chip <%= tarea.estado.replace(' ', '-') %>"><%= tarea.estado %></span>
              </div>
              <p><%= tarea.descripcion %></p>
              <div class="pie">
                <span><strong>Entrega:</strong> <%= tarea.fecha_entrega %></span>
                <form action="/estudiante/tareas/<%= tarea.id %>/estado" method="POST">
                  <input type="hidden" name="estudianteId" value="<%= currentUser.id %>">
                  <select name="estado">
                    <option value="pendiente" <%= tarea.estado === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
                    <option value="en proceso" <%= tarea.estado === 'en proceso' ? 'selected' : '' %>>En proceso</option>
                    <option value="terminado" <%= tarea.estado === 'terminado' ? 'selected' : '' %>>Terminado</option>
                  </select>
                  <button type="submit">Guardar estado</button>
                </form>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>
  <script>
  let conversacionActual = null;

  function agregarMensaje(rol, contenido) {
    const chat = document.getElementById('chatIA');
    const mensaje = document.createElement('p');
    const etiqueta = rol === 'usuario' ? 'Tú: ' : 'PLANUTOR IA: ';
    mensaje.textContent = etiqueta + contenido;
    chat.appendChild(mensaje);
  }

  async function cargarConversaciones() {
    const respuesta = await fetch('/ia/conversaciones');
    if (!respuesta.ok) return;
    const datos = await respuesta.json();
    document.getElementById('limiteIA').textContent = `Consultas disponibles hoy: ${datos.restantes}/${datos.limite}`;
    const contenedor = document.getElementById('conversacionesIA');
    contenedor.innerHTML = '';
    (datos.conversaciones || []).forEach(conversacion => {
      const boton = document.createElement('button');
      boton.type = 'button';
      boton.textContent = conversacion.titulo;
      boton.addEventListener('click', () => abrirConversacion(conversacion.id));
      contenedor.appendChild(boton);
    });
  }

  async function abrirConversacion(id) {
    const respuesta = await fetch(`/ia/conversaciones/${id}`);
    if (!respuesta.ok) return;
    const datos = await respuesta.json();
    conversacionActual = id;
    const chat = document.getElementById('chatIA');
    chat.innerHTML = '';
    datos.mensajes.forEach(mensaje => agregarMensaje(mensaje.rol, mensaje.contenido));
  }

  function nuevaConversacion() {
    conversacionActual = null;
    document.getElementById('chatIA').innerHTML = '';
    document.getElementById('preguntaIA').focus();
  }

  async function buscarConIA() {
    const campo = document.getElementById("preguntaIA");
    const boton = document.getElementById("btnIA");

    const pregunta = campo.value.trim();

    if (!pregunta) {
      document.getElementById('chatIA').textContent = "Escribe una pregunta primero.";
      return;
    }

    // Bloquea el boton para no enviar dos veces la misma pregunta
    boton.disabled = true;
    boton.textContent = "Pensando...";
    agregarMensaje('usuario', pregunta);
    const espera = document.createElement('p');
    espera.id = 'esperaIA';
    espera.textContent = 'PLANUTOR IA: Pensando...';
    document.getElementById('chatIA').appendChild(espera);

    try {
      const resultado = await fetch("/ia/preguntar", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({ pregunta: pregunta, conversacionId: conversacionActual })
      });

      let datos = {};

      try {
        datos = await resultado.json();
      } catch (e) {
        datos = {};
      }

      if (datos.error) {
        espera.textContent = "⚠️ " + datos.error;
      } else if (datos.respuesta) {
        espera.remove();
        conversacionActual = datos.conversacionId;
        agregarMensaje('asistente', datos.respuesta);
        campo.value = '';
        await cargarConversaciones();
      } else {
        espera.textContent =
          " La IA no devolvio respuesta (codigo " + resultado.status + ").";
      }
    } catch (error) {
      console.error(error);
      espera.textContent =
        " No se pudo conectar con el servidor. Verifica que este encendido.";
    } finally {
      boton.disabled = false;
      boton.textContent = "🔍 Buscar";
    }
  }
  cargarConversaciones().catch(() => {});
</script>
</body>

</html>
