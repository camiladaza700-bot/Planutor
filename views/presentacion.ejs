<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Presentación Personal</title>
  <link rel="stylesheet" href="/css/tema.css">
</head>
<body class="pagina-panel">
  <%- include('partials/menu') %>
  <main class="contenedor">
    <section class="hero">
      <h1>Presentación - <%= personaje %></h1>
      <h2><%= perfil.nombre %></h2>
      <% if (perfil.cargo) { %>
        <p><strong>Cargo:</strong> <%= perfil.cargo %></p>
      <% } %>
      <% if (perfil.grado) { %>
        <p><strong>Grado:</strong> <%= perfil.grado %></p>
      <% } %>
      <p><%= perfil.descripcion %></p>
      <a class="volver" href="/">← Volver al inicio</a>
    </section>
  </main>
</body>
</html>
