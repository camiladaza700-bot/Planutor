<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= clase.nombre %> - PLANUTOR</title>
  <link rel="stylesheet" href="/css/tema.css">
</head>

<body class="pagina-panel">
  <%- include('partials/menu') %>

  <div class="contenedor">

    <section class="encabezado">

      <h1><%= clase.nombre %></h1>

      <p class="informacion">
        <strong>Grado:</strong> <%= clase.grado %>
      </p>

      <p class="informacion">
        <strong>Profesor:</strong> <%= profesor.nombre %>
      </p>

      <div class="codigo">
        Código: <%= clase.codigo %>
      </div>

    </section>

    <% if (typeof mensaje !== 'undefined' && mensaje) { %>
      <div class="alerta ok"><%= mensaje %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alerta error"><%= error %></div>
    <% } %>

    <section class="seccion">
      <h2>Editar clase</h2>
      <form action="/clases/profesor/<%= profesor.id %>/<%= clase.id %>/editar" method="POST">
        <label>Nombre <input type="text" name="nombre" value="<%= clase.nombre %>" required></label>
        <label>Grado <input type="text" name="grado" value="<%= clase.grado %>" required></label>
        <button type="submit">Guardar cambios</button>
      </form>
    </section>


    <section class="seccion">

      <h2>Estudiantes de la clase</h2>

      <% if (estudiantes.length === 0) { %>

        <p class="sin-estudiantes">
          Aún no hay estudiantes inscritos en esta clase.
        </p>

      <% } else { %>

        <% estudiantes.forEach(estudiante => { %>

          <div class="estudiante">
            <strong><%= estudiante.nombre %></strong>
            <p><%= estudiante.correo %></p>
            <form action="/clases/profesor/<%= profesor.id %>/<%= clase.id %>/estudiantes/<%= estudiante.id %>/retirar" method="POST" onsubmit="return confirm('¿Retirar a este estudiante de la clase?');">
              <button type="submit" class="borrar">Retirar estudiante</button>
            </form>
          </div>

        <% }) %>

      <% } %>

    </section>


    <a class="volver" href="/clases/profesor/<%= profesor.id %>">
      ← Volver a mis clases
    </a>

  </div>

</body>
</html>
