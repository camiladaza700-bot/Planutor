<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Muro de avisos - PLANUTOR</title>
  <link rel="stylesheet" href="/css/tema.css">
</head>
<body class="pagina-panel">
  <%- include('partials/menu') %>
  <main class="contenedor">
    <section class="hero">
      <h1>Muro de avisos generales</h1>
      <p>Avisos generales publicados por profesores y coordinadores para mantener informada a toda la comunidad educativa.</p>
      <% if (mensaje) { %><div class="alerta ok"><%= mensaje %></div><% } %>
      <% if (error) { %><div class="alerta error"><%= error %></div><% } %>
    </section>

    <% if (puedeAgregar) { %>
      <section class="panel">
        <h2>Publicar nuevo aviso</h2>
        <form action="/eventos-escolares" method="POST">
          <input type="hidden" name="usuarioId" value="<%= currentUser.id %>">
          <label>Titulo</label>
          <input type="text" name="titulo" required>
          <label>Descripcion</label>
          <textarea name="descripcion"></textarea>
          <label>Fecha</label>
          <input type="date" name="fecha" required>
          <label>Tipo</label>
          <select name="tipo">
            <option value="festividad">Festividad</option>
            <option value="reunion">Reunion</option>
            <option value="otro">Otro</option>
          </select>
          <button type="submit">Publicar evento</button>
        </form>
      </section>
    <% } %>

    <section class="lista-box">
      <h2>Proximos eventos</h2>
      <% if (eventos.length === 0) { %>
        <p class="vacio">Todavia no hay eventos escolares publicados.</p>
      <% } else { %>
        <div class="lista">
          <% eventos.forEach((evento) => { %>
            <article class="evento">
              <h3><%= evento.titulo %></h3>
              <div class="meta">
                <span class="chip tipo"><%= evento.tipo %></span>
                <span class="chip autor">Publicado por: <%= evento.creado_por_nombre %></span>
              </div>
              <% if (evento.descripcion) { %><p><%= evento.descripcion %></p><% } %>
              <p><strong>Fecha:</strong> <%= evento.fecha %></p>
              <% if (puedeAgregar) { %>
                <form action="/eventos-escolares/<%= evento.id %>/eliminar" method="POST">
                  <input type="hidden" name="usuarioId" value="<%= currentUser.id %>">
                  <button type="submit" class="borrar">Eliminar evento</button>
                </form>
              <% } %>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
