<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registro de estudiante - PLANUTOR</title>
  <link rel="stylesheet" href="/css/tema.css">
</head>
<body class="pagina-tarjeta">
  <div class="contenedor">
    <h1>Registro de estudiante</h1>
    <p class="subtitulo">Crea tu cuenta en PLANUTOR</p>

    <% if (error) { %>
      <div class="alerta error"><%= error %></div>
    <% } %>

    <% if (mensaje) { %>
      <div class="alerta ok"><%= mensaje %></div>
    <% } %>

    <form action="/registro-estudiante" method="POST">
      <label for="institucion">Institución</label>
<input
  type="text"
  id="institucion"
  name="institucion"
  value="<%= valores.institucion %>"
  readonly
  required
>
      <label for="nombre">Nombre completo</label>
      <input
        type="text"
        id="nombre"
        name="nombre"
        placeholder="Escribe tu nombre completo"
        value="<%= valores.nombre %>"
        required
      >

      <label for="correo">Correo electronico</label>
      <input
        type="email"
        id="correo"
        name="correo"
        placeholder="ejemplo@gmail.com"
        value="<%= valores.correo %>"
        required
      >

      <label for="nivel">Nivel educativo</label>
      <select id="nivel" name="nivel" required>
        <option value="">Selecciona tu nivel</option>
        <option value="primaria" <%= valores.nivel === 'primaria' ? 'selected' : '' %>>Primaria</option>
        <option value="bachillerato" <%= valores.nivel === 'bachillerato' ? 'selected' : '' %>>Bachillerato</option>
      </select>

      <label for="grado">Grado</label>
      <select id="grado" name="grado" required>
        <option value="">Selecciona tu grado</option>
        <% for (let grado = 1; grado <= 11; grado += 1) { %>
          <option value="<%= grado %>" <%= valores.grado === String(grado) ? 'selected' : '' %>><%= grado %>°</option>
        <% } %>
      </select>

      <label for="grupo">Grupo</label>
      <input
        type="text"
        id="grupo"
        name="grupo"
        placeholder="Ejemplo: 10A"
        value="<%= valores.grupo %>"
        required
      >

      <label for="password">Contrasena</label>
      <input
        type="password"
        id="password"
        name="password"
        placeholder="Crea tu contrasena"
        required
      >

      <label for="confirmarPassword">Confirmar contrasena</label>
      <input
        type="password"
        id="confirmarPassword"
        name="confirmarPassword"
        placeholder="Repite tu contrasena"
        required
      >

      <button type="submit">REGISTRARME</button>
    </form>

    <a href="/" class="volver">Volver</a>
  </div>

  
</body>
</html>