<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registro - PLANUTOR</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/login.css">
</head>
<body class="login-page">
  <main class="login-wrap">
    <section class="login-card role-card">
      <div class="login-avatar" aria-hidden="true"><img src="/logo-planutor.svg" alt=""></div>
      <h1>Crear cuenta</h1>
      <p class="login-brand">PLANUTOR</p>
      <p class="role-description">Selecciona cómo quieres registrarte.</p>
      <div class="role-actions">
        <a href="/registro-profesor" class="login-btn role-button"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2M17 5l1.5 1.5L21 3"/></svg>Soy profesor</a>
        <a href="/registro-estudiante" class="login-btn role-button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6l9-3 9 3-9 3zM6 10v5c0 2 3 4 6 4s6-2 6-4v-5M21 6v7"/></svg>Soy estudiante</a>
      </div>
    </section>
    <div class="login-divider"></div>
    <p class="login-register">¿Ya tienes una cuenta? <a href="/">Inicia sesión</a></p>
  </main>
</body>
</html>
