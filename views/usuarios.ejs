<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Usuarios registrados - PLANUTOR</title>
  <link rel="stylesheet" href="/css/tema.css">
</head>
<body class="pagina-panel">
  <%- include('partials/menu') %>
  <main class="contenedor">
    <section class="encabezado">
      <h1>Usuarios registrados</h1>
      <p>Gestiona usuarios, accesos, roles e instituciones de PLANUTOR.</p>

      <% if (currentUser) { %>
        <p><strong>Usuario actual:</strong> <%= currentUser.nombre %> (<%= currentUser.rol %>)</p>
      <% } %>

      <% if (bienvenida) { %>
        <div class="welcome-banner" role="status">¡Bienvenido/a, <%= currentUser.nombre %>!</div>
      <% } %>

      <% if (mensaje) { %>
        <div class="alerta ok"><%= mensaje %></div>
      <% } %>

      <% if (error) { %>
        <div class="alerta error"><%= error %></div>
      <% } %>

      <div class="acciones">
        <% if (currentUser) { %>
          <a href="/panel/<%= currentUser.id %>">Recargar panel</a>
        <% } else { %>
          <a href="/">Ir al login</a>
        <% } %>
        <a href="/inicio">Registrar otra cuenta</a>
      </div>
    </section>

    <% if (usuarios.length === 0) { %>
      <section class="vacio">
        <p>No hay usuarios registrados todavia.</p>
      </section>
    <% } else { %>
      <table class="tabla">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Rol</th>
            <th>Nivel</th>
            <th>Grado</th>
            <th>Grupo</th>
            <th>Institución</th>
            <th>Estado</th>
            <th>Creado</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% usuarios.forEach((usuario) => { %>
            <tr>
              <td><%= usuario.nombre %></td>
              <td><%= usuario.correo %></td>
              <td><%= usuario.rol %></td>
              <td><%= usuario.nivel || '-' %></td>
              <td><%= usuario.grado || '-' %></td>
              <td><%= usuario.grupo || '-' %></td>
              <td><%= usuario.institucion || '-' %></td>
              <td><%= usuario.activo ? 'Activa' : 'Desactivada' %></td>
              <td><%= usuario.creado_en %></td>
              <td>
                <button class="boton-gestionar" type="button" onclick="abrirGestionUsuario('gestionUsuario<%= usuario.id %>')">Gestionar</button>
                <dialog id="gestionUsuario<%= usuario.id %>" class="dialogo-gestion" aria-labelledby="tituloGestionUsuario<%= usuario.id %>">
                  <div class="dialogo-encabezado">
                    <div>
                      <p class="sobrelinea">ADMINISTRACIÓN DE CUENTA</p>
                      <h2 id="tituloGestionUsuario<%= usuario.id %>"><%= usuario.nombre %></h2>
                    </div>
                    <button class="cerrar-dialogo" type="button" onclick="cerrarGestionUsuario('gestionUsuario<%= usuario.id %>')" aria-label="Cerrar ventana">×</button>
                  </div>
                  <form action="/usuarios/<%= usuario.id %>/editar" method="POST">
                    <label>Nombre <input name="nombre" value="<%= usuario.nombre %>" required></label>
                    <label>Correo <input type="email" name="correo" value="<%= usuario.correo %>" required></label>
                    <label>Rol
                      <select name="rol" <%= currentUser && currentUser.id === usuario.id ? 'disabled' : '' %>>
                        <% ['estudiante', 'profesor', 'administrador'].forEach(rol => { %>
                          <option value="<%= rol %>" <%= usuario.rol === rol ? 'selected' : '' %>><%= rol %></option>
                        <% }) %>
                      </select>
                      <% if (currentUser && currentUser.id === usuario.id) { %><input type="hidden" name="rol" value="administrador"><% } %>
                    </label>
                    <% if (usuario.rol === 'profesor') { %>
                      <label>Institución
                        <select name="institucion">
                          <option value="">Pendiente de asignación</option>
                          <% instituciones.forEach(institucion => { %>
                            <option value="<%= institucion.nombre %>" <%= usuario.institucion === institucion.nombre ? 'selected' : '' %>><%= institucion.nombre %></option>
                          <% }) %>
                        </select>
                      </label>
                    <% } else { %>
                      <input type="hidden" name="institucion" value="<%= usuario.institucion || '' %>">
                    <% } %>
                    <label>Nivel <input name="nivel" value="<%= usuario.nivel || '' %>"></label>
                    <label>Grado <input name="grado" value="<%= usuario.grado || '' %>"></label>
                    <label>Grupo <input name="grupo" value="<%= usuario.grupo || '' %>"></label>
                    <button type="submit">Guardar usuario</button>
                  </form>

                  <% if (!currentUser || currentUser.id !== usuario.id) { %>
                    <form action="/usuarios/<%= usuario.id %>/estado" method="POST">
                      <button type="submit"><%= usuario.activo ? 'Desactivar cuenta' : 'Activar cuenta' %></button>
                    </form>
                    <form action="/usuarios/<%= usuario.id %>/eliminar" method="POST" onsubmit="return confirm('¿Eliminar esta cuenta y sus datos relacionados? Esta acción no se puede deshacer.');">
                      <button type="submit" class="borrar">Eliminar cuenta</button>
                    </form>
                  <% } else { %>
                    <p>No puedes desactivar ni eliminar tu propia cuenta.</p>
                  <% } %>
                </dialog>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <section class="seccion">
      <h2>Instituciones</h2>
      <form action="/instituciones" method="POST">
        <label>Nueva institución <input name="nombre" required></label>
        <button type="submit">Agregar institución</button>
      </form>

      <% if (instituciones.length === 0) { %>
        <p class="vacio">No hay instituciones creadas todavía.</p>
      <% } else { %>
        <div class="lista">
          <% instituciones.forEach(institucion => { %>
            <article class="tarea">
              <form action="/instituciones/<%= institucion.id %>/editar" method="POST">
                <label>Nombre <input name="nombre" value="<%= institucion.nombre %>" required></label>
                <button type="submit">Guardar</button>
              </form>
              <p>Usuarios asignados: <%= institucion.usuarios_asignados %></p>
              <% if (Number(institucion.usuarios_asignados) === 0) { %>
                <form action="/instituciones/<%= institucion.id %>/eliminar" method="POST" onsubmit="return confirm('¿Eliminar esta institución?');">
                  <button type="submit" class="borrar">Eliminar institución</button>
                </form>
              <% } %>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>
  <script>
    function abrirGestionUsuario(id) {
      const dialogo = document.getElementById(id);
      if (typeof dialogo.showModal === 'function') dialogo.showModal();
      else dialogo.setAttribute('open', '');
    }

    function cerrarGestionUsuario(id) {
      const dialogo = document.getElementById(id);
      if (typeof dialogo.close === 'function') dialogo.close();
      else dialogo.removeAttribute('open');
    }

    document.querySelectorAll('.dialogo-gestion').forEach(dialogo => {
      dialogo.addEventListener('click', evento => {
        if (evento.target === dialogo) dialogo.close();
      });
    });
  </script>
</body>
</html>
