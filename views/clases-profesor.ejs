<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mis clases - PLANUTOR</title>
  <link rel="stylesheet" href="/css/tema.css">
</head>

<body class="pagina-panel">
  <%- include('partials/menu') %>

  <div class="contenedor">

    <h1>Mis clases</h1>

    <p class="bienvenida">
      Profesor: <strong><%= profesor.nombre %></strong>
    </p>

    <% if (mensaje) { %>
      <div class="alerta ok"><%= mensaje %></div>
    <% } %>
    <% if (error) { %>
      <div class="alerta error"><%= error %></div>
    <% } %>

    <section class="crear-clase">
      <h2>Crear una nueva clase</h2>

      <form action="/clases/crear" method="POST">

        <input
          type="hidden"
          name="profesorId"
          value="<%= profesor.id %>"
        >

        <input
          type="text"
          name="nombre"
          placeholder="Nombre de la clase. Ej: Matemáticas"
          required
        >

        <input
          type="text"
          name="grado"
          placeholder="Grado. Ej: 11°"
          required
        >

        <button type="submit">
          Crear clase
        </button>

      </form>
    </section>

    <section>

      <h2>Clases creadas</h2>

      <br>

      <% if (clases.length === 0) { %>

        <p>Aún no has creado ninguna clase.</p>

      <% } else { %>

        <div class="clases">

          <% clases.forEach(clase => { %>

            <div class="clase">

              <h3>
                <%= clase.nombre %>
              </h3>

              <p>
                <strong>Grado:</strong>
                <%= clase.grado %>
              </p>

              <div class="codigo">
                <%= clase.codigo %>
              </div>
              <p>Comparte este código con tus estudiantes.</p>

              <p><a href="/clases/profesor/<%= profesor.id %>/<%= clase.id %>">Gestionar clase y estudiantes</a></p>

              <form action="/clases/profesor/<%= profesor.id %>/<%= clase.id %>/eliminar" method="POST" onsubmit="return confirm('¿Eliminar esta clase? También se eliminarán sus tareas y el progreso registrado de los estudiantes.');">
                <button type="submit" class="borrar">Eliminar clase</button>
              </form>

            </div>

          <% }) %>

        </div>

      <% } %>

    </section>

    <a
      class="volver"
      href="/panel/<%= profesor.id %>"
    >
      ← Volver al panel
    </a>

  </div>

</body>
</html>
