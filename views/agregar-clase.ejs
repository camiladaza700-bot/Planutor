<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Agregar clase - PLANUTOR</title>
  <link rel="stylesheet" href="/css/tema.css">
</head>

<body class="pagina-tarjeta">
  <%- include('partials/menu') %>

  <div class="contenedor">

    <h1>Agregar clase o curso</h1>

    <p>
      Ingresa el código que te dio tu profesor.
    </p>

    <% if (mensaje) { %>
      <div class="alerta ok"><%= mensaje %></div>
    <% } %>
    <% if (error) { %>
      <div class="alerta error"><%= error %></div>
    <% } %>

    <form action="/clases/unirse" method="POST">

      <input
        type="hidden"
        name="estudianteId"
        value="<%= estudiante.id %>"
      >

      <input
        type="text"
        name="codigo"
        placeholder="Ej: ABC-123"
        maxlength="7"
        required
      >

      <button type="submit">
        Unirme a la clase
      </button>

    </form>

    <section class="seccion">
      <h2>Mis clases inscritas</h2>
      <% if (clases.length === 0) { %>
        <p>Aún no estás inscrito en ninguna clase.</p>
      <% } else { %>
        <% clases.forEach(clase => { %>
          <article class="clase">
            <h3><%= clase.nombre %></h3>
            <p><strong>Grado:</strong> <%= clase.grado %></p>
            <p><strong>Profesor:</strong> <%= clase.profesor_nombre %></p>
            <form action="/clases/estudiante/<%= estudiante.id %>/<%= clase.id %>/salir" method="POST" onsubmit="return confirm('¿Salir de esta clase? Ya no verás sus tareas.');">
              <button type="submit" class="borrar">Salir de la clase</button>
            </form>
          </article>
        <% }) %>
      <% } %>
    </section>

    <a
      class="volver"
      href="/panel/<%= estudiante.id %>"
    >
      ← Volver al panel
    </a>

  </div>

</body>
</html>
