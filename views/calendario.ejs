<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calendario - PLANUTOR V2</title>
  <link rel="stylesheet" href="/css/tema.css">
</head>
<body class="pagina-panel">
  <%- include('partials/menu') %>
  <div class="contenedor">
    <h1>Calendario - <%= personaje %></h1>

    <% if (currentUserId) { %>
        <div class="aviso guardando"> Tus notas se guardan en tu cuenta y estarán disponibles en cualquier dispositivo donde inicies sesión.</div>
    <% } else { %>
        <div class="aviso invitado"> No iniciaste sesión, así que las notas solo se guardarán en este navegador y se perderán al borrar el caché. <a href="/">Inicia sesión</a> para guardarlas en tu cuenta.</div>
    <% } %>

    <div class="calendar-wrap">
        <div class="calendar" id="calendar">
            <div class="cal-header">
                <button id="prev" aria-label="Mes anterior">◀</button>
                <strong id="cal-month">Mes Año</strong>
                <button id="next" aria-label="Mes siguiente">▶</button>
            </div>
            <div style="text-align:center; margin-bottom:10px;">
                <button class="hoy-btn" id="ir-hoy">Ir a hoy</button>
            </div>

            <div class="cal-weekdays">
                <div>Dom</div><div>Lun</div><div>Mar</div><div>Mié</div><div>Jue</div><div>Vie</div><div>Sáb</div>
            </div>

            <div class="cal-grid" id="grid">
                <!-- celdas generadas por JS -->
            </div>
        </div>

        <aside class="sidebar">
            <h3>Añadir nota</h3>
            <p id="selected-label">Haz clic en un día del calendario para seleccionarlo.</p>
            <div>
                <label for="nota-text">Nota / Tarea:</label>
                <input id="nota-text" type="text" placeholder="Ej: Entregar informe...">
                <button id="add-note" class="add-btn">Añadir a fecha seleccionada</button>
            </div>
            <hr>
            <h4>Notas del día seleccionado</h4>
            <ul id="quick-list"><li class="vacio">Selecciona un día primero.</li></ul>
            <a class="volver" href="<%= currentUserId ? '/panel/' + currentUserId : '/' %>">← Volver al inicio</a>
        </aside>
    </div>
  </div>

    <script>
        // Calendario con día actual resaltado y notas persistidas.
        // Si hay sesión (currentUserId), las notas se guardan en la BD vía API.
        // Si no hay sesión, se usa localStorage como respaldo temporal.
        const personaje = '<%= personaje %>';
        const currentUserId = <%- currentUserId ? currentUserId : 'null' %>;
        const eventosEscolares = <%- JSON.stringify(eventos || []) %>;
        const anotacionesPlaneador = <%- JSON.stringify(typeof anotacionesPlaneador !== 'undefined' ? anotacionesPlaneador : []) %>;

        function toISO(d) {
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${y}-${m}-${day}`;
        }

        const hoy = new Date();
        const hoyISO = toISO(hoy);
        const state = { date: new Date(hoy.getFullYear(), hoy.getMonth(), 1), selected: null, notas: {} };

        const eventosPorFecha = eventosEscolares.reduce((mapa, evento) => {
            mapa[evento.fecha] = mapa[evento.fecha] || [];
            mapa[evento.fecha].push({
                ...evento,
                origen: 'escolar'
            });
            return mapa;
        }, {});

        const planeadorPorFecha = anotacionesPlaneador
            .filter(anotacion => anotacion.estado !== 'archivada')
            .reduce((mapa, anotacion) => {
                mapa[anotacion.fecha] = mapa[anotacion.fecha] || [];
                mapa[anotacion.fecha].push({
                    ...anotacion,
                    origen: 'planeador'
                });
                return mapa;
            }, {});

        function elementosDelDia(fecha) {
            return [
                ...(eventosPorFecha[fecha] || []),
                ...(planeadorPorFecha[fecha] || []),
                ...(state.notas[fecha] || [])
            ];
        }

        // ---------- Respaldo local (solo si no hay sesión) ----------
        function keyFor() { return 'planner_guest'; }
        function loadLocal() { try { return JSON.parse(localStorage.getItem(keyFor()) || '{}'); } catch (e) { return {}; } }
        function saveLocal(d) { localStorage.setItem(keyFor(), JSON.stringify(d)); }

        // ---------- API backend (si hay sesión) ----------
        async function apiListar() {
            const res = await fetch(`/calendario/notas?usuarioId=${currentUserId}`);
            if (!res.ok) throw new Error('Error al listar notas');
            const data = await res.json();
            const mapa = {};
            (data.notas || []).forEach(n => {
                mapa[n.fecha] = mapa[n.fecha] || [];
                mapa[n.fecha].push(n);
            });
            return mapa;
        }

        async function apiCrear(fecha, titulo, origen) {
            const res = await fetch('/calendario/notas', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ usuarioId: currentUserId, fecha, titulo, origen })
            });
            if (!res.ok) throw new Error('Error al guardar nota');
            return res.json();
        }

        async function apiEliminar(id) {
            const res = await fetch(`/calendario/notas/${id}?usuarioId=${currentUserId}`, { method: 'DELETE' });
            if (!res.ok) throw new Error('Error al eliminar nota');
            return res.json();
        }

        // ---------- Carga inicial de datos ----------
        async function cargarDatos() {
            if (currentUserId) {
                state.notas = await apiListar();
            } else {
                state.notas = loadLocal();
            }
        }

        async function agregarNota(fecha, titulo) {
            if (currentUserId) {
                const { nota } = await apiCrear(fecha, titulo, 'personal');
                state.notas[fecha] = state.notas[fecha] || [];
                state.notas[fecha].push(nota);
            } else {
                const data = loadLocal();
                data[fecha] = data[fecha] || [];
                data[fecha].push({ titulo, origen: 'personal', creado: new Date().toISOString() });
                saveLocal(data);
                state.notas = data;
            }
        }

        async function eliminarNota(fecha, idx) {
            const nota = state.notas[fecha][idx];
            if (currentUserId && nota.id) {
                await apiEliminar(nota.id);
            } else {
                const data = loadLocal();
                data[fecha].splice(idx, 1);
                saveLocal(data);
            }
            state.notas[fecha].splice(idx, 1);
        }

        // ---------- Render ----------
        function renderCalendar() {
            const grid = document.getElementById('grid');
            grid.innerHTML = '';
            const year = state.date.getFullYear();
            const month = state.date.getMonth();
            document.getElementById('cal-month').textContent =
                state.date.toLocaleString('es-ES', { month: 'long', year: 'numeric' });

            const startDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();

            for (let i = 0; i < startDay; i++) {
                const cell = document.createElement('div');
                cell.className = 'cal-cell empty';
                grid.appendChild(cell);
            }

            for (let day = 1; day <= daysInMonth; day++) {
                const dt = new Date(year, month, day);
                const iso = toISO(dt);
                const cell = document.createElement('div');
                cell.className = 'cal-cell';
                if (iso === hoyISO) cell.classList.add('today');
                if (iso === state.selected) cell.classList.add('selected');

                const dateEl = document.createElement('div');
                dateEl.className = 'date';
                dateEl.textContent = day;
                cell.appendChild(dateEl);

                const notes = elementosDelDia(iso);
                notes.slice(0, 3).forEach(n => {
                    const nEl = document.createElement('div');
                    nEl.className = 'note' + (n.origen === 'escolar' || n.origen === 'inicial' || n.origen === 'planeador' ? ' inicial' : '');
                    nEl.textContent = n.titulo;
                    cell.appendChild(nEl);
                });
                if (notes.length > 3) {
                    const more = document.createElement('div');
                    more.className = 'note-more';
                    more.textContent = `+${notes.length - 3} más`;
                    cell.appendChild(more);
                }

                cell.addEventListener('click', () => selectDate(iso));
                grid.appendChild(cell);
            }
        }

        function selectDate(iso) {
            state.selected = iso;
            const dt = new Date(iso + 'T00:00:00');
            document.getElementById('selected-label').textContent =
                'Fecha seleccionada: ' + dt.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
            document.getElementById('nota-text').focus();
            renderCalendar();
            renderQuickList();
        }

        function renderQuickList() {
            const list = document.getElementById('quick-list');
            list.innerHTML = '';
            if (!state.selected) {
                list.innerHTML = '<li class="vacio">Selecciona un día primero.</li>';
                return;
            }
            const items = elementosDelDia(state.selected);
            if (items.length === 0) {
                list.innerHTML = '<li class="vacio">Sin notas para este día.</li>';
                return;
            }
            items.forEach((it, idx) => {
                const li = document.createElement('li');
                const span = document.createElement('span');
                const tipo = it.origen === 'escolar' || it.origen === 'inicial'
                    ? ' (evento)'
                    : it.origen === 'planeador' ? ' (planeador)' : '';
                span.textContent = it.titulo + tipo;
                li.appendChild(span);

                if (it.origen === 'personal') {
                    const notaIdx = (state.notas[state.selected] || []).indexOf(it);
                    const del = document.createElement('button');
                    del.textContent = '✕';
                    del.title = 'Eliminar nota';
                    del.addEventListener('click', async () => {
                        del.disabled = true;
                        try {
                            await eliminarNota(state.selected, notaIdx);
                            renderCalendar();
                            renderQuickList();
                        } catch (err) {
                            console.error(err);
                            alert('No se pudo eliminar la nota. Intenta de nuevo.');
                            del.disabled = false;
                        }
                    });
                    li.appendChild(del);
                }
                list.appendChild(li);
            });
        }

        document.getElementById('add-note').addEventListener('click', async () => {
            const boton = document.getElementById('add-note');
            const text = document.getElementById('nota-text').value.trim();
            if (!state.selected) { alert('Selecciona una fecha del calendario primero.'); return; }
            if (!text) { alert('Escribe una descripción para la nota.'); return; }

            boton.disabled = true;
            try {
                await agregarNota(state.selected, text);
                document.getElementById('nota-text').value = '';
                renderCalendar();
                renderQuickList();
            } catch (err) {
                console.error(err);
                alert('No se pudo guardar la nota. Intenta de nuevo.');
            } finally {
                boton.disabled = false;
            }
        });

        document.getElementById('nota-text').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') document.getElementById('add-note').click();
        });

        document.getElementById('prev').addEventListener('click', () => {
            state.date = new Date(state.date.getFullYear(), state.date.getMonth() - 1, 1);
            renderCalendar();
        });
        document.getElementById('next').addEventListener('click', () => {
            state.date = new Date(state.date.getFullYear(), state.date.getMonth() + 1, 1);
            renderCalendar();
        });
        document.getElementById('ir-hoy').addEventListener('click', () => {
            state.date = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
            selectDate(hoyISO);
        });

        // ---------- Inicializar ----------
        (async function init() {
            await cargarDatos();
            renderCalendar();
        })();
    </script>
</body>
</html>
